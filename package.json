{
  "name": "paylater.js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && size-limit",
    "size": "size-limit",
    "preview": "vite preview"
  },
  "size-limit": [
    {
      "name": "paylater.js (gzip)",
      "path": "dist/paylater.js",
      "limit": "8 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^14.2.0",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
